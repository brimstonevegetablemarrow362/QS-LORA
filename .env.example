# AWS Bedrock (required only for LLM judging of QA pairs)
# Copy to .env and fill in real values:
#   cp .env.example .env
#   chmod 600 .env
#   source scripts/source_bedrock_env.sh

AWS_ACCESS_KEY_ID=AKIAREPLACE_WITH_YOUR_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_YOUR_SECRET
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Optional: Bedrock API key auth instead of IAM access keys
# AWS_BEARER_TOKEN_BEDROCK=

# Judge model (Claude Haiku on Bedrock)
BEDROCK_JUDGE_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Optional ceiling / comparison models used in some thesis scripts
BEDROCK_ANTHROPIC_CEILING_MODEL_ID=us.anthropic.claude-opus-4-8
BEDROCK_NOVA_CEILING_MODEL_ID=us.amazon.nova-2-lite-v1:0

# --- Local QA generator (vLLM) ---
GENERATOR_VLLM_HOST=127.0.0.1
GENERATOR_VLLM_PORT=8100
# GENERATOR_VLLM_URL=http://127.0.0.1:8100
# After merge, set to your merged folder path or served model id:
GENERATOR_VLLM_MODEL=./out/merged-qa-generator

# Hugging Face token if base Llama weights are gated
# HF_TOKEN=
